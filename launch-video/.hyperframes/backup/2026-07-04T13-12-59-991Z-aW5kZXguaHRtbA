<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=1442, height=817">
    <script src="https://cdn.jsdelivr.net/npm/animejs@4.0.2/lib/anime.iife.min.js"></script>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { margin: 0; width: 1442px; height: 817px; overflow: hidden; background: #000; }
      body { font-family: "Inter", sans-serif; -webkit-font-smoothing: antialiased; color: #e7e9ea; }

      :root {
        --text: #e6e9ea; --muted: #71757a; --blue: #1e9cf1;
        --b-outer: #2f3336; --b-list: #2b2e31; --b-line: #202327;
        --in: #202327; --icbg: #16181d; --avbg: #3d4043; --daysep: #64696d;
      }

      #stage { position: absolute; inset: 0; background: #000; }
      .x-app { display: flex; width: 1442px; height: 817px; background: #000; }
      .ic { fill: currentColor; display: block; flex: 0 0 auto; }

      /* ---------- nav rail (157px container, 68px column right-aligned) ---------- */
      .rail { flex: 0 0 auto; width: 157px; height: 817px; display: flex; }
      .rail__col { width: 68px; margin-left: auto; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: space-between; padding: 4px 8px 10px; }
      .rail__top { display: flex; flex-direction: column; align-items: center; }
      .rail__logo { width: 49px; height: 49px; display: flex; align-items: center; justify-content: center; color: var(--text); }
      .rail__logo .ic { width: 23px; height: 28px; }
      .rail__item { width: 46px; height: 46px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--text); position: relative; margin: 4px 0; }
      .rail__item .ic { width: 24.5px; height: 24.5px; }
      .rail__dot { position: absolute; top: 9px; right: 11px; width: 6px; height: 6px; border-radius: 50%; background: var(--blue); }
      .rail__bottom { display: flex; flex-direction: column; align-items: center; gap: 8px; }
      .rail__compose { width: 46px; height: 46px; border-radius: 50%; background: #eff3f4; color: #0f1419; display: flex; align-items: center; justify-content: center; }
      .rail__compose .ic { width: 23px; height: 23px; }
      .rail__me { width: 38px; height: 38px; border-radius: 50%; background: var(--avbg) center/cover; box-shadow: inset 0 0 0 2px rgba(255,255,255,0.03); }

      /* ---------- content block (bordered) ---------- */
      .content { display: flex; height: 817px; border-left: 1px solid var(--b-outer); border-right: 1px solid var(--b-outer); }

      /* ---------- chat list ---------- */
      .list { flex: 0 0 auto; width: 415px; border-right: 1px solid var(--b-list); display: flex; flex-direction: column; min-height: 0; }
      .list__head { height: 64px; display: flex; align-items: center; justify-content: space-between; padding: 8px 16px; }
      .list__title { font-size: 20px; font-weight: 800; color: var(--text); letter-spacing: -0.2px; }
      .list__acts { display: flex; align-items: center; gap: 8px; }
      .allpill { height: 36px; display: flex; align-items: center; gap: 4px; padding: 0 10px 0 16px; border-radius: 18px; border: 1px solid var(--b-list); font-size: 15px; font-weight: 500; color: var(--text); }
      .allpill .ic { width: 16px; height: 16px; fill: var(--muted); }
      .icbtn { height: 36px; min-width: 36px; border-radius: 18px; border: 1px solid var(--b-list); display: flex; align-items: center; justify-content: center; color: var(--text); }
      .icbtn .ic { width: 20px; height: 20px; }
      .searchwrap { padding: 4px 16px 8px; }
      .search { display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 20px; background: var(--icbg); border: 1px solid var(--b-line); color: var(--muted); font-size: 15px; }
      .search .ic { width: 20px; height: 20px; fill: var(--muted); }
      .rows { flex: 1 1 auto; overflow: hidden; }
      .conv { display: flex; gap: 16px; padding: 0 16px; height: 80px; }
      .conv__av { flex: 0 0 auto; width: 56px; height: 56px; border-radius: 50%; background: var(--avbg) center/cover; margin: 12px 0; }
      .conv__body { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; justify-content: center; gap: 2px; border-bottom: 1px solid var(--b-line); }
      .conv__top { display: flex; align-items: center; }
      .conv__nm { display: flex; align-items: center; gap: 2px; min-width: 0; }
      .conv__nm b { font-size: 15px; font-weight: 700; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .conv__nm .ic { width: 15px; height: 15px; fill: var(--blue); flex: 0 0 auto; }
      .conv__time { margin-left: auto; font-size: 15px; font-weight: 500; color: var(--muted); flex: 0 0 auto; padding-left: 8px; }
      .conv__pv { font-size: 15px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

      /* ---------- conversation pane (772px, message area border) ---------- */
      .pane { flex: 0 0 auto; width: 772px; display: flex; flex-direction: column; min-width: 0; border-right: 1px solid var(--b-line); position: relative; }
      .pane__head { height: 80px; flex: 0 0 auto; display: flex; align-items: center; gap: 12px; padding: 0 16px; }
      .pane__av { width: 48px; height: 48px; border-radius: 50%; background: var(--avbg) center/cover; flex: 0 0 auto; }
      .pane__nm { display: flex; align-items: center; gap: 4px; font-size: 17px; font-weight: 500; color: var(--text); }
      .pane__nm .ic { width: 17px; height: 17px; fill: var(--blue); }
      .pane__acts { margin-left: auto; display: flex; align-items: center; gap: 8px; }
      .headbtn { width: 40px; height: 40px; border-radius: 50%; background: var(--icbg); display: flex; align-items: center; justify-content: center; color: var(--text); }
      .headbtn .ic { width: 22px; height: 22px; }

      .thread { flex: 1 1 auto; display: flex; flex-direction: column; padding: 4px 0 8px; overflow: hidden; }
      .thread-scroll { display: flex; flex-direction: column; will-change: transform; }
      .profile { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 20px 16px 24px; }
      .profile__av { width: 64px; height: 64px; border-radius: 50%; background: var(--avbg) center/cover; margin-bottom: 12px; }
      .profile__nm { display: flex; align-items: center; gap: 4px; font-size: 17px; font-weight: 700; color: var(--text); }
      .profile__nm .ic { width: 17px; height: 17px; fill: var(--blue); }
      .profile__handle { font-size: 15px; color: var(--muted); margin-top: 2px; }
      .profile__meta { font-size: 15px; color: var(--muted); }
      .profile__btn { margin-top: 20px; height: 36px; padding: 0 16px; border-radius: 18px; background: var(--text); color: #000; font-size: 15px; font-weight: 700; display: flex; align-items: center; }

      .daysep { align-self: center; font-size: 13px; font-weight: 700; color: var(--daysep); margin: 8px 0; }
      .daysep--gap { margin-top: 18px; }
      .sysline { align-self: center; text-align: center; max-width: 420px; font-size: 13px; color: var(--daysep); margin: 2px 0 8px; }

      .row { display: flex; width: 100%; padding: 1px 16px; position: relative; }
      .row--in { justify-content: flex-start; }
      .row--out { justify-content: flex-end; }
      .row.gap-top { margin-top: 12px; }

      .bubble { max-width: 424px; padding: 8px 16px; font-size: 15px; line-height: 20px; border-radius: 14px; word-wrap: break-word; }
      .bubble--out { background: var(--blue); color: #fff; transform-origin: bottom right; }
      .bubble--in  { background: var(--in); color: var(--text); transform-origin: bottom left; }
      .incol { display: flex; flex-direction: column; align-items: flex-start; }
      .edited { font-size: 11px; color: var(--muted); margin: 4px 0 0 4px; }

      /* image attachment (X renders sent images as rounded, no bubble bg) */
      .bubble--img { padding: 0; background: transparent; max-width: 300px; border-radius: 14px; overflow: hidden; line-height: 0; }
      .bubble--img img { display: block; width: 100%; height: auto; aspect-ratio: 1024 / 576; }

      /* typing indicator */
      .typing { position: absolute; left: 16px; bottom: 1px; display: inline-flex; align-items: center; gap: 5px; padding: 12px 15px; background: var(--in); border-radius: 14px; transform-origin: bottom left; }
      .typing span { width: 7px; height: 7px; border-radius: 50%; background: var(--muted); }

      /* animated (pitch) messages start hidden; anime.js reveals them.
         scale(0.5) from the sender-corner origin gives the pop. */
      .pending { opacity: 0; transform: scale(0.5); }
      .fade0 { opacity: 0; }

      /* ---------- compose ---------- */
      .compose { flex: 0 0 auto; display: flex; justify-content: center; padding: 12px 16px 16px; }
      .compose__inner { display: flex; align-items: center; gap: 8px; width: 100%; max-width: 720px; }
      .composebtn { width: 40px; height: 40px; border-radius: 50%; background: var(--icbg); display: flex; align-items: center; justify-content: center; color: var(--text); flex: 0 0 auto; }
      .composebtn .ic { width: 22px; height: 22px; }
      .compose__field { flex: 1 1 auto; height: 44px; display: flex; align-items: center; padding: 0 16px; background: var(--in); border-radius: 22px; color: var(--muted); font-size: 15px; }
    </style>
  </head>
