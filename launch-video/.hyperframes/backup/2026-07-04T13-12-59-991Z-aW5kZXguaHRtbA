      const T5 = target("p5");   // typing + reply row

      scroll.style.transform = "translateY(" + Th + "px)";

      const scrollAnim = anime.animate(scroll, {
        keyframes: [
          { translateY: Th, duration: 400 },
          { translateY: T1, duration: 300, ease: SCROLL },
          { translateY: T1, duration: 300 },
          { translateY: T2, duration: 300, ease: SCROLL },
          { translateY: T2, duration: 300 },
          { translateY: T3, duration: 300, ease: SCROLL },
          { translateY: T3, duration: 300 },
          { translateY: T4, duration: 300, ease: SCROLL },
          { translateY: T4, duration: 300 },
          { translateY: T5, duration: 300, ease: SCROLL },
        ],
        autoplay: false,
      });
      window.__hfAnime.push(scrollAnim);

      // Timing is baked into keyframes (a leading "hold"), NOT `delay`.
      // HyperFrames seeks each anim by composition time and ignores `delay`,
      // so delays would pop every bubble at t0. Keyframes seek correctly,
      // giving the stagger — one bubble pops at a time.
      function pop(id, at) {
        const a = anime.animate("#" + id, {
          keyframes: [
            { opacity: 0, scale: 0.5, duration: at },   // hold hidden until `at`
            { opacity: 1, scale: 1, duration: 300, ease: POP },
          ],
          autoplay: false,
        });
        window.__hfAnime.push(a);
      }
      // the "Today" separator + encryption line appear with the first
      // message sent today (not at t0)
      function fade(id, at) {
        const a = anime.animate("#" + id, {
          keyframes: [
            { opacity: 0, duration: at },
            { opacity: 1, duration: 260, ease: "outQuad" },
          ],
          autoplay: false,
        });
        window.__hfAnime.push(a);
      }
      fade("daytoday", 360);
      fade("e2e", 440);

      pop("p1", 400);
      pop("p2", 1000);
      pop("p3", 1600);
      pop("p4", 2200);
      pop("p5", 3900);

      // typing indicator (single keyframed anim so it stays hidden until its cue)
      function typing(target, at, dur) {
        const a = anime.animate(target, {
          keyframes: [
            { opacity: 0, scale: 0.5, duration: at },   // hold hidden until `at`
            { opacity: 1, scale: 1, duration: 220, ease: POP },
            { opacity: 1, duration: Math.max(0, dur - 220 - 160) },
            { opacity: 0, scale: 0.6, duration: 160, ease: "inQuad" },
          ],
          autoplay: false,
        });
        const dots = anime.animate(target + " span", {
          keyframes: [
            { translateY: 0, duration: at + 120 },
            { translateY: -4, duration: 240, ease: "inOutSine" },
            { translateY: 0, duration: 240, ease: "inOutSine" },
            { translateY: -4, duration: 240, ease: "inOutSine" },
            { translateY: 0, duration: 240, ease: "inOutSine" },
          ],
          autoplay: false,
        });
        window.__hfAnime.push(a, dots);
      }
      typing("#t1", 2800, 1000);
    </script>
  </body>
</html>
